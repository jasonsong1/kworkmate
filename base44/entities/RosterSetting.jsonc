{
  "name": "RosterSetting",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "shifts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fixed_staff": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "min_rest_hours": {
      "type": "number",
      "default": 10
    },
    "max_days_per_week": {
      "type": "number",
      "default": 5
    },
    "day_overrides": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "max_shifts_per_day": {
      "type": "number",
      "default": 2
    },
    "shift_overrides": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "branch_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}