{
  "name": "InterviewSlot",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "duration_min": {
      "type": "number",
      "default": 20
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "booked",
        "cancelled"
      ],
      "default": "open"
    },
    "booked_by_applicant_id": {
      "type": "string"
    },
    "booked_by_name": {
      "type": "string"
    },
    "booked_at": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "start_time"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}