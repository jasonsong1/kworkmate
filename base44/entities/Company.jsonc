{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "abn": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "brand_color": {
      "type": "string",
      "default": "#4338ca"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_super_fund_name": {
      "type": "string"
    },
    "default_super_fund_abn": {
      "type": "string"
    },
    "default_super_fund_usi": {
      "type": "string"
    },
    "default_super_fund_phone": {
      "type": "string"
    },
    "auto_reject_email": {
      "type": "boolean",
      "default": true
    },
    "mini_interview_enabled": {
      "type": "boolean",
      "default": true
    },
    "video_interview_enabled": {
      "type": "boolean",
      "default": false
    },
    "allow_interview_reschedule": {
      "type": "boolean",
      "default": false
    },
    "interview_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "video_interview_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "screening_criteria": {
      "type": "string"
    },
    "ai_top_n": {
      "type": "number",
      "default": 10
    },
    "email_brand_color": {
      "type": "string"
    },
    "email_footer": {
      "type": "string"
    },
    "email_templates": {
      "type": "object"
    },
    "role_permissions": {
      "type": "object"
    },
    "custom_roles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "job_design": {
      "type": "object"
    },
    "onboarding_docs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "onboarding_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "package": {
      "type": "string"
    },
    "package_start_date": {
      "type": "string"
    },
    "package_reactivated_at": {
      "type": "string"
    },
    "package_job_lock": {
      "type": "boolean",
      "default": false
    },
    "job_limit_override": {
      "type": "number"
    },
    "employee_limit_override": {
      "type": "number"
    },
    "pay_multipliers": {
      "type": "object"
    },
    "pay_overrides": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "holiday_exclusions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "qr_design": {
      "type": "object"
    },
    "deactivated": {
      "type": "boolean",
      "default": false
    },
    "deactivated_at": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.member_emails": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "update": {
      "$or": [
        {
          "data.member_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.member_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}