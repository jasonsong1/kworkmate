{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "p256dh": {
      "type": "string"
    },
    "auth": {
      "type": "string"
    },
    "device_label": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "ko"
      ],
      "default": "en"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "failure_count": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    },
    "last_success_at": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "endpoint",
    "p256dh",
    "auth"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}