{
  "name": "PasswordReset",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "used_at": {
      "type": "string"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}