{
  "name": "Job",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "casual",
        "part_time",
        "full_time"
      ],
      "default": "casual"
    },
    "hourly_rate": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "required_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "custom_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "closed"
      ],
      "default": "draft"
    },
    "logo_url": {
      "type": "string"
    },
    "header_image_url": {
      "type": "string"
    },
    "brand_color": {
      "type": "string"
    },
    "poster_note": {
      "type": "string"
    },
    "screening_min_score": {
      "type": "number",
      "default": 60
    },
    "screening_criteria": {
      "type": "string"
    },
    "auto_reject_email": {
      "type": "boolean",
      "default": true
    },
    "mini_interview_enabled": {
      "type": "boolean",
      "default": true
    },
    "video_interview_enabled": {
      "type": "boolean",
      "default": false
    },
    "contact_email": {
      "type": "string"
    },
    "top_n_cycle": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}