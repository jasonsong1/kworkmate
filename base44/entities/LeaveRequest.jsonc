{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_number": {
      "type": "string"
    },
    "leave_type_key": {
      "type": "string"
    },
    "leave_type_name": {
      "type": "string"
    },
    "paid": {
      "type": "boolean",
      "default": true
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "days": {
      "type": "number",
      "default": 1
    },
    "hours": {
      "type": "number",
      "default": 0
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "decision_reason": {
      "type": "string"
    },
    "decided_by_email": {
      "type": "string"
    },
    "decided_by_name": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "certificate_file_uri": {
      "type": "string"
    },
    "certificate_filename": {
      "type": "string"
    },
    "notified_at": {
      "type": "string"
    }
  },
  "required": [
    "employee_email",
    "leave_type_key",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}